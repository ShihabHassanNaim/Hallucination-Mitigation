# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.puku/ 
.puku/puku-embeddings.db

# Project artefacts
data/index/
data/index_ragtruth/
data/preds.jsonl
data/metrics.json
*.log

# Datasets and reference papers that are fetched or downloaded rather
# than authored here. The build scripts under scripts/ regenerate the
# JSONL splits from them, and the committed JSONL is what the
# evaluation actually reads.
data/ragtruth_test.parquet
*.pdf

# IDE
.vscode/
.idea/
*.swp

# Working directories for one-off scripts and intermediate artefacts.
# The book build and the literature review both leave these behind; the
# durable results are committed under scripts/thesis/ and docs/.
.work/
scratchpad/

# Word owner-lock files. Word writes these next to a document while it is
# open, and they contain the local account name, so they are never meant
# to leave the machine.
~$*.docx

# Superseded builds of the thesis book. Book/CRISP_test.docx is the
# current one and is the file the verification tests read; the others are
# earlier builds kept as working copies.
Book/_new_book.docx
Book/*.docx.bak
CRISP_Thesis_Book.docx
